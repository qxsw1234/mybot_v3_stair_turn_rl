      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="FL_foot">
    <sensor name="FL_foot_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <contact>
        <collision>FL_foot_collision</collision>
      </contact>
      <plugin name="FL_foot_contact_plugin" filename="libgazebo_ros_bumper.so">
        <frame_name>FL_foot</frame_name>
        <ros>
          <namespace>/</namespace>
          <remapping>bumpers:=/FL_foot/contact</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>
